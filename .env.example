# SmartHome Monitor Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# eWeLink Gateway Configuration
# ============================================

# iHost Gateway URL (IP address or domain)
# Find your gateway IP in your router's DHCP client list
# or use http://ihost.local if mDNS is supported
VITE_GATEWAY_URL=http://192.168.1.100

# Access Token for API authentication
# Get this by pressing the pairing button on your gateway
# then calling: GET /open-api/v2/rest/bridge/access_token
# Token is valid until regenerated
VITE_GATEWAY_TOKEN=your-access-token-here

# ============================================
# Application Settings (Optional)
# ============================================

# Application name (used for API identification)
VITE_APP_NAME=SmartHome Monitor

# Auto-refresh interval in milliseconds (default: 10000 = 10 seconds)
VITE_REFRESH_INTERVAL=10000

# Enable debug logging (true/false)
VITE_DEBUG=false

# ============================================
# Backend Configuration (Future Use)
# ============================================

# Backend API URL (when backend is implemented)
# VITE_API_URL=http://localhost:3000/api

# Backend WebSocket URL for real-time updates
# VITE_WS_URL=ws://localhost:3000/ws

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable/disable features
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_NOTIFICATIONS=false
VITE_ENABLE_ANALYTICS=false

# ============================================
# Security (Backend Only)
# ============================================

# JWT Secret for backend authentication
# JWT_SECRET=your-super-secret-jwt-key-change-this

# Session timeout in minutes
# SESSION_TIMEOUT=60

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
